{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8940"
      ],
      "port": 8940
    },
    {
      "name": "static2",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8941"
      ],
      "port": 8941
    },
    {
      "name": "static-auto",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server ${PORT:-8942}"
      ],
      "port": 8942,
      "autoPort": true
    }
  ]
}