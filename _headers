/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)

/sw.js
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# The map is app.html. Cloudflare serves it at /app and redirects /app.html
# there, like index.html at / (now the homepage).
/home-a
  Cache-Control: no-cache

/home-b
  Cache-Control: no-cache

/home-c
  Cache-Control: no-cache

/app
  Cache-Control: no-cache

/app.html
  Cache-Control: no-cache

/admin.html
  Cache-Control: no-cache
  X-Frame-Options: DENY

# Cloudflare serves admin.html at /admin too (pretty URLs).
/admin
  Cache-Control: no-cache
  X-Frame-Options: DENY

/manifest.json
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=604800

# Homepage screenshots. A new screenshot gets a new file name.
/img/*
  Cache-Control: public, max-age=604800

/data/*
  Cache-Control: public, max-age=3600
